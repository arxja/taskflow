{
  "name": "taskflow",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.9.14",
    "@biomejs/biome": "^1.7.3"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:cli": "bun run scripts/build-cli.ts",
    "test:watch": "bun test --watch",
    "db:migrate": "bun run src/db/migrate.ts",
    "lint": "turbo lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "clean": "turbo clean"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "chalk": "^5.6.2"
  }
}